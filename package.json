{
  "name": "maple-events",
  "private": true,
  "scripts": {
    "dev": "start cmd /k \"cd server && npm run dev\" && start cmd /k \"cd client && npm run dev\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "export:booking-design": "playwright test tests/e2e/export-booking-form-design.spec.ts",
    "export:booking-design-pdf": "playwright test tests/e2e/export-booking-form-design.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
