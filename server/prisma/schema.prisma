// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// הטבלה המרכזית של ההזמנות - גרסה משודרגת עם שני צדדים
model EventDate {
  id        String   @id @default(uuid())
  date      DateTime @unique
  status    String   @default("AVAILABLE")
  lockedBy  String?
  booking   Booking?
}

model Booking {
  id                String    @id @default(uuid())
  eventDate         EventDate @relation(fields: [calendarDateId], references: [id])

  // --- פרטי צד א' (חובה) ---
  clientAFullName   String
  clientAIdNumber   String
  clientAPhone      String
  clientAEmail      String?
  clientAAddress    String?

  // --- פרטי צד ב' (רשות) ---
  clientBFullName   String?
  clientBIdNumber   String?
  clientBPhone      String?
  clientBEmail      String?
  clientBAddress    String?

  // --- פרטי האירוע ---
  calendarDateId    String   @unique
  eventType         String
  guestCount        Int
  finalPricePortion Float

  // --- הערות ---
  managerComments   String?
  clientComments    String?

  // --- היסטוריה ---
  createdAt         DateTime @default(now())
  createdBy         String
  updatedAt         DateTime @updatedAt
  updatedBy         String?

  // --- כספים ---
  totalPrice        Float
  paidAmount        Float    @default(0)
  paymentStatus     String   @default("pending")
}